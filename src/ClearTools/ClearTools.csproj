<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<!--<ImplicitUsings>enable</ImplicitUsings>-->
		<Nullable>enable</Nullable>

		<Version>3.6.2</Version>
		<ProduceReferenceAssembly>True</ProduceReferenceAssembly>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>

		<Authors>Godwin Ehichoya</Authors>
		<Company>Clearwox Systems</Company>
		<Copyright>Copyright 2018</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<Description>
			A set of general utilities suitable for any .net project.
			These utilities include, string manipulation, image,
			cryptography, http client, number base utility, Azure App Configuration,
			Azure Key Vault integration, and more.
		</Description>
		<PackageTags>string utility, image, file, azure storage, azure app configuration, azure key vault, cryptography, http client, number base utility, feature flags</PackageTags>

		<PackageProjectUrl>https://github.com/Clearwox/ClearTools/</PackageProjectUrl>
		<License>https://github.com/Clearwox/ClearTools?tab=MIT-1-ov-file</License>
		<RepositoryUrl>https://github.com/Clearwox/ClearTools/</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Data.AppConfiguration" Version="1.11.1" />
		<PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.13" />
		<PackageReference Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" Version="8.6.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ClearTools.Abstraction\ClearTools.Abstraction.csproj" />
	</ItemGroup>

</Project>
